{
  "extends": "@chomp/shared/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@chomp/shared": ["../../packages/shared/dist/index.d.ts"],
      "@chomp/shared/*": ["../../packages/shared/dist/*"]
    }
  },
  "include": ["src/**/*"]
}